{
  "name": "@bydtech/model-retire",
  "version": "0.1.0",
  "description": "Find deprecated, retiring and retired LLM model IDs in a codebase before a provider shuts them off.",
  "keywords": [
    "llm",
    "deprecation",
    "model",
    "openai",
    "anthropic",
    "gemini",
    "vertex-ai",
    "bedrock",
    "mistral",
    "cohere",
    "scanner",
    "cli",
    "ci"
  ],
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/model-retire.git"
  },
  "homepage": "https://github.com/BYDTechSolutions/model-retire#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/model-retire/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "model-retire": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-data": "node scripts/check-data.mjs",
    "sync-data": "node scripts/sync-data.mjs",
    "parity": "node scripts/parity.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
